@inherits LayoutComponentBase
@using scada_demo_test.Web.Services
@inject LiveTelemetryState Live
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* This is the ONE master layout - every page (Monitoring, Summary, Charts,
   Reports...) renders inside it, so sidebar/topbar/footer only exist here once. *@

@if (_alertToasts.Count > 0)
{
    <div class="alert-toast-stack">
        @foreach (var toast in _alertToasts)
        {
            <div class="alert-toast @SeverityCss(toast.Incident.Severity)" @onclick="() => DismissToast(toast.Id)" style="cursor: pointer;" title="Click to dismiss">
                <div class="alert-toast-header">
                    <div class="alert-toast-title">
                        <span class="alert-toast-dot"></span>
                        @toast.Incident.Severity alert - @toast.Incident.DeviceName
                    </div>
                    <button type="button" class="alert-toast-close" @onclick:stopPropagation="true" @onclick="() => DismissToast(toast.Id)" title="Close">&times;</button>
                </div>
                <div class="alert-toast-msg">@toast.Incident.Message</div>
                <div class="alert-toast-time">@toast.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
            </div>
        }
    </div>
}

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="app-shell @(IsCollapsed ? "sidebar-collapsed" : "")" @ref="_shell">
    <NavMenu IsCollapsed="IsCollapsed" IsMobileOpen="IsMobileOpen" OnBackdropClick="CloseMobile" />

    <div class="app-main">
        <TopBar OnToggleSidebar="ToggleSidebar" OnToggleMobile="ToggleMobile" IsCollapsed="IsCollapsed" IsMobileOpen="IsMobileOpen" />

        <main id="main-content" class="app-content" tabindex="-1">
            @Body
        </main>

        <footer class="app-footer">
            ALAM IOT Enterprises &middot; Since 1990
        </footer>
    </div>
</div>

@code {
    private bool IsCollapsed = false;   // desktop: icon-only mode
    private bool IsMobileOpen = false;  // mobile: off-canvas open/closed
    private ElementReference _shell;
    private IJSObjectReference? _sidebarModule;
    private DotNetObjectReference<MainLayout>? _self;

    private readonly record struct AlertToast(Guid Id, LiveTelemetryState.AlertIncidentDto Incident, DateTime Timestamp);
    private readonly List<AlertToast> _alertToasts = new();

    private void DismissToast(Guid id)
    {
        _alertToasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private static string SeverityCss(string severity) => severity.ToLowerInvariant() switch
    {
        "critical" => "critical",
        "info" => "info",
        _ => "warning"
    };

    protected override void OnInitialized()
    {
        Live.OnAlertIncident += HandleAlertIncident;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _sidebarModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sidebar.js");
        _self = DotNetObjectReference.Create(this);
        await _sidebarModule.InvokeVoidAsync("initialize", _shell, _self);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
        => _ = InvokeAsync(() => { CloseMobile(); StateHasChanged(); });

    private void HandleAlertIncident(LiveTelemetryState.AlertIncidentDto incident)
    {
        var toast = new AlertToast(incident.Id, incident, DateTime.UtcNow);
        _alertToasts.Add(toast);
        StateHasChanged();

        // Auto-dismiss after 6 seconds unless a newer incident replaced it.
        _ = Task.Run(async () =>
        {
            await Task.Delay(6000);
            await InvokeAsync(() =>
            {
                _alertToasts.RemoveAll(t => t.Id == toast.Id);
                StateHasChanged();
            });
        });
    }

    private void ToggleSidebar()
    {
        IsCollapsed = !IsCollapsed;
    }

    private void ToggleMobile()
    {
        IsMobileOpen = !IsMobileOpen;
    }

    [JSInvokable]
    public Task DismissMobileSidebar() => InvokeAsync(() => { CloseMobile(); StateHasChanged(); });

    private void CloseMobile()
    {
        IsMobileOpen = false;
    }

    public async ValueTask DisposeAsync()
    {
        Live.OnAlertIncident -= HandleAlertIncident;
        Navigation.LocationChanged -= OnLocationChanged;
        if (_sidebarModule is not null)
        {
            try
            {
                await _sidebarModule.InvokeVoidAsync("dispose", _shell);
                await _sidebarModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
